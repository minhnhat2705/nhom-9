# ===========================
# LUMIE SMART WAREHOUSE
# Environment Configuration
# ===========================
# Copy file này thành .env và điền thông tin thực tế của bạn
# KHÔNG commit file .env lên Git

# ----- Server -----
PORT=5001
NODE_ENV=development

# ----- Database MySQL -----
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3307/lumie_warehouse"
# Ví dụ: mysql://root:123456@localhost:3307/lumie_warehouse
# Nếu dùng XAMPP mặc định: mysql://root:@localhost:3307/lumie_warehouse

# ----- JWT Authentication -----
# Thay YOUR_SECRET bằng chuỗi ngẫu nhiên dài ít nhất 32 ký tự
JWT_ACCESS_SECRET=lumie_access_secret_change_this_in_production_min32chars
JWT_REFRESH_SECRET=lumie_refresh_secret_change_this_in_production_min32chars

# Access Token hết hạn sau 15 phút
JWT_ACCESS_EXPIRES_IN=15m

# Refresh Token hết hạn sau 7 ngày
JWT_REFRESH_EXPIRES_IN=7d

# ----- CORS -----
# URL của Frontend (Vite chạy ở port 5173 mặc định)
FRONTEND_URL=http://localhost:5173

# ----- Bcrypt -----
# Số vòng lặp hash (10-12 là cân bằng tốt giữa bảo mật và tốc độ)
BCRYPT_ROUNDS=12

# ----- Account Locking -----
# Số lần đăng nhập sai tối đa trước khi khóa
MAX_LOGIN_ATTEMPTS=5

# Thời gian khóa (phút)
LOCK_TIME_MINUTES=15
