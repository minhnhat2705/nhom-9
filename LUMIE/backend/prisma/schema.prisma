// ============================================================
// Prisma Schema - Lumié Smart Warehouse
// Database: MySQL (lumie_warehouse)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// BẢNG: roles
// Lưu trữ các vai trò trong hệ thống (WAREHOUSE_MANAGER, WAREHOUSE_STAFF)
// ============================================================
model Role {
  id          Int      @id @default(autoincrement())
  role_name   String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  created_at  DateTime @default(now())

  // Quan hệ: Một role có nhiều users
  users       User[]

  @@map("roles")
}

// ============================================================
// BẢNG: warehouses
// Lưu trữ thông tin các kho hàng
// ============================================================
model Warehouse {
  id              Int      @id @default(autoincrement())
  warehouse_code  String   @unique @db.VarChar(20)
  warehouse_name  String   @db.VarChar(100)
  address         String?  @db.VarChar(255)
  description     String?  @db.Text
  status          WarehouseStatus @default(ACTIVE)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Quan hệ: Một kho có nhiều nhân viên
  users           User[]

  // Quan hệ: Một kho có nhiều bản ghi tồn kho
  inventories     Inventory[]
  receipts        Receipt[]

  @@map("warehouses")
}

// ============================================================
// BẢNG: users
// Lưu trữ thông tin tài khoản người dùng
// ============================================================
model User {
  id                    Int       @id @default(autoincrement())
  full_name             String    @db.VarChar(100)
  email                 String    @unique @db.VarChar(150)
  password_hash         String    @db.VarChar(255)
  phone                 String?   @db.VarChar(20)

  // Quan hệ với role
  role_id               Int
  role                  Role      @relation(fields: [role_id], references: [id])

  // Quan hệ với warehouse (có thể NULL)
  warehouse_id          Int?
  warehouse             Warehouse? @relation(fields: [warehouse_id], references: [id])

  // Trạng thái tài khoản
  status                UserStatus @default(ACTIVE)

  // Bảo mật đăng nhập
  failed_login_attempts Int       @default(0)
  locked_until          DateTime?
  last_login            DateTime?

  // Yêu cầu đổi mật khẩu lần đầu
  must_change_password  Boolean   @default(false)

  // Timestamps
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  deleted_at            DateTime? // Xóa mềm (soft delete)

  // Quan hệ với các bảng khác
  refresh_tokens        RefreshToken[]
  audit_logs_created    AuditLog[] @relation("AuditLogCreatedBy")
  created_receipts      Receipt[]  @relation("ReceiptCreatedBy")
  approved_receipts     Receipt[]  @relation("ReceiptApprovedBy")

  @@map("users")
}

// ============================================================
// BẢNG: refresh_tokens
// Quản lý refresh token để duy trì phiên đăng nhập an toàn
// ============================================================
model RefreshToken {
  id         Int       @id @default(autoincrement())
  user_id    Int
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash String    @unique @db.VarChar(255)
  expires_at DateTime
  revoked_at DateTime? // NULL = còn hiệu lực
  created_at DateTime  @default(now())

  @@index([user_id])
  @@map("refresh_tokens")
}

// ============================================================
// BẢNG: audit_logs
// Ghi lại lịch sử thao tác quản trị quan trọng
// ============================================================
model AuditLog {
  id          Int      @id @default(autoincrement())
  user_id     Int?     // Người thực hiện thao tác (NULL nếu hệ thống)
  actor       User?    @relation("AuditLogCreatedBy", fields: [user_id], references: [id])
  action      String   @db.VarChar(100) // Ví dụ: CREATE_USER, DISABLE_USER, RESET_PASSWORD
  description String?  @db.Text         // Mô tả chi tiết
  target_id   Int?                       // ID của đối tượng bị tác động
  target_type String?  @db.VarChar(50)  // Loại đối tượng (user, warehouse, v.v.)
  ip_address  String?  @db.VarChar(45)  // IPv4 hoặc IPv6
  created_at  DateTime @default(now())

  @@index([user_id])
  @@map("audit_logs")
}

// ============================================================
// BẢNG: categories
// Danh mục sản phẩm (Áo thun, Sơ mi, Quần jean, v.v.)
// ============================================================
model Category {
  id            Int       @id @default(autoincrement())
  category_code String    @unique @db.VarChar(50)
  category_name String    @db.VarChar(100)
  rack_zone     String?   @db.VarChar(20) // Kệ zone: A, B, C...
  description   String?   @db.Text
  status        Status    @default(ACTIVE)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  products      Product[]

  @@map("categories")
}

// ============================================================
// BẢNG: suppliers
// Nhà cung cấp thời trang (Routine, Zara, Canifa, Nike...)
// ============================================================
model Supplier {
  id             Int       @id @default(autoincrement())
  supplier_code  String    @unique @db.VarChar(50)
  supplier_name  String    @db.VarChar(150)
  brand_name     String?   @db.VarChar(100)
  contact_person String?   @db.VarChar(100)
  phone          String?   @db.VarChar(20)
  email          String?   @db.VarChar(100)
  address        String?   @db.VarChar(255)
  status         Status    @default(ACTIVE)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  products       Product[]
  receipts       Receipt[]

  @@map("suppliers")
}

// ============================================================
// BẢNG: products
// Thông tin sản phẩm cha
// ============================================================
model Product {
  id            Int             @id @default(autoincrement())
  product_code  String          @unique @db.VarChar(50)
  product_name  String          @db.VarChar(255)
  category_id   Int
  category      Category        @relation(fields: [category_id], references: [id])
  supplier_id   Int
  supplier      Supplier        @relation(fields: [supplier_id], references: [id])
  brand         String?         @db.VarChar(100)
  gender        Gender          @default(UNISEX)
  material      String?         @db.VarChar(100)
  description   String?         @db.Text
  image_url     String?         @db.VarChar(255)
  status        Status          @default(ACTIVE)
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt

  variants      ProductVariant[]

  @@index([category_id])
  @@index([supplier_id])
  @@map("products")
}

// ============================================================
// BẢNG: product_variants
// Biến thể chi tiết: SKU, Mã vạch, Size, Màu, Giá nhập, Giá bán
// ============================================================
model ProductVariant {
  id            Int         @id @default(autoincrement())
  product_id    Int
  product       Product     @relation(fields: [product_id], references: [id], onDelete: Cascade)
  sku           String      @unique @db.VarChar(100)
  barcode       String      @unique @db.VarChar(100)
  size          String      @db.VarChar(20)
  color         String      @db.VarChar(50)
  color_code    String?     @db.VarChar(20)
  import_price  Decimal     @default(0.00) @db.Decimal(15, 2)
  selling_price Decimal     @default(0.00) @db.Decimal(15, 2)
  profit_margin Decimal?    @db.Decimal(6, 4)
  min_stock     Int         @default(10)
  status        Status      @default(ACTIVE)
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  inventories   Inventory[]
  receipt_items ReceiptItem[]

  @@index([product_id])
  @@map("product_variants")
}

// ============================================================
// BẢNG: inventories
// Tồn kho thực tế theo từng kho & vị trí kệ
// ============================================================
model Inventory {
  id             Int            @id @default(autoincrement())
  variant_id     Int
  variant        ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  warehouse_id   Int
  warehouse      Warehouse      @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)
  quantity       Int            @default(0)
  shelf_location String?        @db.VarChar(50)
  stock_status   String?        @db.VarChar(50) // 'Đủ hàng', 'Sắp hết', 'Hết hàng'
  last_checked_at DateTime?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  @@unique([variant_id, warehouse_id])
  @@index([variant_id])
  @@index([warehouse_id])
  @@map("inventories")
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum Status {
  ACTIVE
  INACTIVE
}

enum Gender {
  UNISEX
  MALE
  FEMALE
}

enum ReceiptStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================
// BẢNG: receipts
// Phiếu nhập kho: Nhân viên tạo, Quản lý duyệt
// ============================================================
model Receipt {
  id               Int           @id @default(autoincrement())
  receipt_code     String        @unique @db.VarChar(50)
  warehouse_id     Int
  warehouse        Warehouse     @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)
  supplier_id      Int?
  supplier         Supplier?     @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  created_by_id    Int
  created_by       User          @relation("ReceiptCreatedBy", fields: [created_by_id], references: [id], onDelete: Cascade)
  approved_by_id   Int?
  approved_by      User?         @relation("ReceiptApprovedBy", fields: [approved_by_id], references: [id], onDelete: SetNull)
  status           ReceiptStatus @default(PENDING)
  total_quantity   Int           @default(0)
  total_amount     Decimal       @default(0.00) @db.Decimal(15, 2)
  notes            String?       @db.Text
  rejection_reason String?       @db.Text
  approved_at      DateTime?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  items            ReceiptItem[]

  @@index([warehouse_id])
  @@index([supplier_id])
  @@index([created_by_id])
  @@index([approved_by_id])
  @@map("receipts")
}

// ============================================================
// BẢNG: receipt_items
// Chi tiết mặt hàng trong phiếu nhập kho
// ============================================================
model ReceiptItem {
  id             Int            @id @default(autoincrement())
  receipt_id     Int
  receipt        Receipt        @relation(fields: [receipt_id], references: [id], onDelete: Cascade)
  variant_id     Int
  variant        ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  quantity       Int            @default(1)
  unit_price     Decimal        @default(0.00) @db.Decimal(15, 2)
  total_price    Decimal        @default(0.00) @db.Decimal(15, 2)
  shelf_location String?        @db.VarChar(50)
  notes          String?        @db.VarChar(255)

  @@index([receipt_id])
  @@index([variant_id])
  @@map("receipt_items")
}
