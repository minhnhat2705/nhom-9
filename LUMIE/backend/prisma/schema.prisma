// ============================================================
// Prisma Schema - Lumié Smart Warehouse
// Database: MySQL (lumie_warehouse)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// BẢNG: roles
// Lưu trữ các vai trò trong hệ thống (WAREHOUSE_MANAGER, WAREHOUSE_STAFF)
// ============================================================
model Role {
  id          Int      @id @default(autoincrement())
  role_name   String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  created_at  DateTime @default(now())

  // Quan hệ: Một role có nhiều users
  users       User[]

  @@map("roles")
}

// ============================================================
// BẢNG: warehouses
// Lưu trữ thông tin các kho hàng
// ============================================================
model Warehouse {
  id              Int      @id @default(autoincrement())
  warehouse_code  String   @unique @db.VarChar(20)
  warehouse_name  String   @db.VarChar(100)
  address         String?  @db.VarChar(255)
  description     String?  @db.Text
  status          WarehouseStatus @default(ACTIVE)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Quan hệ: Một kho có nhiều nhân viên
  users           User[]

  // Quan hệ: Một kho có nhiều bản ghi tồn kho
  inventories     Inventory[]
  receipts        Receipt[]
  export_receipts ExportReceipt[] @relation("ExportWarehouse")
  transfers_from  StockTransfer[] @relation("TransferFromWarehouse")
  transfers_to    StockTransfer[] @relation("TransferToWarehouse")
  stock_audits    StockAudit[]    @relation("AuditWarehouse")
  historical_sales HistoricalSale[] @relation("WarehouseHistoricalSales")
  replenishment_suggestions ReplenishmentSuggestion[]
  purchase_orders PurchaseOrder[]
  alerts          SystemAlert[]

  @@map("warehouses")
}

// ============================================================
// BẢNG: users
// Lưu trữ thông tin tài khoản người dùng
// ============================================================
model User {
  id                    Int       @id @default(autoincrement())
  full_name             String    @db.VarChar(100)
  email                 String    @unique @db.VarChar(150)
  password_hash         String    @db.VarChar(255)
  phone                 String?   @db.VarChar(20)

  // Quan hệ với role
  role_id               Int
  role                  Role      @relation(fields: [role_id], references: [id])

  // Quan hệ với warehouse (có thể NULL)
  warehouse_id          Int?
  warehouse             Warehouse? @relation(fields: [warehouse_id], references: [id])

  // Trạng thái tài khoản
  status                UserStatus @default(ACTIVE)

  // Bảo mật đăng nhập
  failed_login_attempts Int       @default(0)
  locked_until          DateTime?
  last_login            DateTime?

  // Yêu cầu đổi mật khẩu lần đầu
  must_change_password  Boolean   @default(false)

  // Timestamps
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  deleted_at            DateTime? // Xóa mềm (soft delete)

  // Quan hệ với các bảng khác
  refresh_tokens        RefreshToken[]
  audit_logs_created    AuditLog[] @relation("AuditLogCreatedBy")
  created_receipts      Receipt[]  @relation("ReceiptCreatedBy")
  approved_receipts     Receipt[]  @relation("ReceiptApprovedBy")
  created_exports       ExportReceipt[] @relation("ExportCreatedBy")
  approved_exports      ExportReceipt[] @relation("ExportApprovedBy")
  created_transfers     StockTransfer[] @relation("TransferCreatedBy")
  approved_transfers    StockTransfer[] @relation("TransferApprovedBy")
  created_audits        StockAudit[]    @relation("AuditCreatedBy")
  assigned_audits       StockAudit[]    @relation("AuditAssignedTo")
  approved_audits       StockAudit[]    @relation("AuditApprovedBy")
  created_purchase_orders PurchaseOrder[] @relation("UserPurchaseOrders")
  notification_states   NotificationRecipient[]

  @@map("users")
}

// ============================================================
// BẢNG: refresh_tokens
// Quản lý refresh token để duy trì phiên đăng nhập an toàn
// ============================================================
model RefreshToken {
  id         Int       @id @default(autoincrement())
  user_id    Int
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash String    @unique @db.VarChar(255)
  expires_at DateTime
  revoked_at DateTime? // NULL = còn hiệu lực
  created_at DateTime  @default(now())

  @@index([user_id])
  @@map("refresh_tokens")
}

// ============================================================
// BẢNG: audit_logs
// Ghi lại lịch sử thao tác quản trị quan trọng
// ============================================================
model AuditLog {
  id          Int      @id @default(autoincrement())
  user_id     Int?     // Người thực hiện thao tác (NULL nếu hệ thống)
  actor       User?    @relation("AuditLogCreatedBy", fields: [user_id], references: [id])
  action      String   @db.VarChar(100) // Ví dụ: CREATE_USER, DISABLE_USER, RESET_PASSWORD
  description String?  @db.Text         // Mô tả chi tiết
  target_id   Int?                       // ID của đối tượng bị tác động
  target_type String?  @db.VarChar(50)  // Loại đối tượng (user, warehouse, v.v.)
  ip_address  String?  @db.VarChar(45)  // IPv4 hoặc IPv6
  created_at  DateTime @default(now())

  @@index([user_id])
  @@map("audit_logs")
}

// ============================================================
// BẢNG: categories
// Danh mục sản phẩm (Áo thun, Sơ mi, Quần jean, v.v.)
// ============================================================
model Category {
  id            Int       @id @default(autoincrement())
  category_code String    @unique @db.VarChar(50)
  category_name String    @db.VarChar(100)
  rack_zone     String?   @db.VarChar(20) // Kệ zone: A, B, C...
  description   String?   @db.Text
  status        Status    @default(ACTIVE)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  products      Product[]

  @@map("categories")
}

// ============================================================
// BẢNG: suppliers
// Nhà cung cấp thời trang (Routine, Zara, Canifa, Nike...)
// ============================================================
model Supplier {
  id             Int       @id @default(autoincrement())
  supplier_code  String    @unique @db.VarChar(50)
  supplier_name  String    @db.VarChar(150)
  brand_name     String?   @db.VarChar(100)
  contact_person String?   @db.VarChar(100)
  phone          String?   @db.VarChar(20)
  email          String?   @db.VarChar(100)
  address        String?   @db.VarChar(255)
  lead_time      Int?      @default(7)
  min_order_qty  Int?      @default(10)
  status         Status    @default(ACTIVE)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  products       Product[]
  receipts       Receipt[]
  purchase_orders PurchaseOrder[]
  replenishment_suggestions ReplenishmentSuggestion[]

  @@map("suppliers")
}

// ============================================================
// BẢNG: products
// Thông tin sản phẩm cha
// ============================================================
model Product {
  id            Int             @id @default(autoincrement())
  product_code  String          @unique @db.VarChar(50)
  product_name  String          @db.VarChar(255)
  category_id   Int
  category      Category        @relation(fields: [category_id], references: [id])
  supplier_id   Int
  supplier      Supplier        @relation(fields: [supplier_id], references: [id])
  brand         String?         @db.VarChar(100)
  gender        Gender          @default(UNISEX)
  material      String?         @db.VarChar(100)
  description   String?         @db.Text
  image_url     String?         @db.VarChar(255)
  status        Status          @default(ACTIVE)
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt

  variants      ProductVariant[]
  replenishment_suggestions ReplenishmentSuggestion[]
  alerts        SystemAlert[]

  @@index([category_id])
  @@index([supplier_id])
  @@map("products")
}

// ============================================================
// BẢNG: product_variants
// Biến thể chi tiết: SKU, Mã vạch, Size, Màu, Giá nhập, Giá bán
// ============================================================
model ProductVariant {
  id            Int         @id @default(autoincrement())
  product_id    Int
  product       Product     @relation(fields: [product_id], references: [id], onDelete: Cascade)
  sku           String      @unique @db.VarChar(100)
  barcode       String      @unique @db.VarChar(100)
  size          String      @db.VarChar(20)
  color         String      @db.VarChar(50)
  color_code    String?     @db.VarChar(20)
  import_price  Decimal     @default(0.00) @db.Decimal(15, 2)
  selling_price Decimal     @default(0.00) @db.Decimal(15, 2)
  profit_margin Decimal?    @db.Decimal(6, 4)
  min_stock     Int         @default(10)
  status        Status      @default(ACTIVE)
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  inventories   Inventory[]
  receipt_items ReceiptItem[]
  export_items  ExportReceiptItem[]
  transfer_items StockTransferItem[]
  audit_items    StockAuditItem[]
  historical_sales HistoricalSale[] @relation("VariantHistoricalSales")
  purchase_order_items PurchaseOrderItem[]
  replenishment_suggestions ReplenishmentSuggestion[]
  alerts               SystemAlert[]

  @@index([product_id])
  @@map("product_variants")
}

// ============================================================
// BẢNG: inventories
// Tồn kho thực tế theo từng kho & vị trí kệ
// ============================================================
model Inventory {
  id             Int            @id @default(autoincrement())
  variant_id     Int
  variant        ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  warehouse_id   Int
  warehouse      Warehouse      @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)
  quantity       Int            @default(0)
  shelf_location String?        @db.VarChar(50)
  stock_status   String?        @db.VarChar(50) // 'Đủ hàng', 'Sắp hết', 'Hết hàng'
  last_checked_at DateTime?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  @@unique([variant_id, warehouse_id])
  @@index([variant_id])
  @@index([warehouse_id])
  @@map("inventories")
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum Status {
  ACTIVE
  INACTIVE
}

enum Gender {
  UNISEX
  MALE
  FEMALE
}

enum ReceiptStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================
// BẢNG: receipts
// Phiếu nhập kho: Nhân viên tạo, Quản lý duyệt
// ============================================================
model Receipt {
  id               Int           @id @default(autoincrement())
  receipt_code     String        @unique @db.VarChar(50)
  warehouse_id     Int
  warehouse        Warehouse     @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)
  supplier_id      Int?
  supplier         Supplier?     @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  created_by_id    Int
  created_by       User          @relation("ReceiptCreatedBy", fields: [created_by_id], references: [id], onDelete: Cascade)
  approved_by_id   Int?
  approved_by      User?         @relation("ReceiptApprovedBy", fields: [approved_by_id], references: [id], onDelete: SetNull)
  status           ReceiptStatus @default(PENDING)
  total_quantity   Int           @default(0)
  total_amount     Decimal       @default(0.00) @db.Decimal(15, 2)
  notes            String?       @db.Text
  rejection_reason String?       @db.Text
  approved_at      DateTime?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  items            ReceiptItem[]

  @@index([warehouse_id])
  @@index([supplier_id])
  @@index([created_by_id])
  @@index([approved_by_id])
  @@map("receipts")
}

// ============================================================
// BẢNG: receipt_items
// Chi tiết mặt hàng trong phiếu nhập kho
// ============================================================
model ReceiptItem {
  id             Int            @id @default(autoincrement())
  receipt_id     Int
  receipt        Receipt        @relation(fields: [receipt_id], references: [id], onDelete: Cascade)
  variant_id     Int
  variant        ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  quantity       Int            @default(1)
  unit_price     Decimal        @default(0.00) @db.Decimal(15, 2)
  total_price    Decimal        @default(0.00) @db.Decimal(15, 2)
  shelf_location String?        @db.VarChar(50)
  notes          String?        @db.VarChar(255)

  @@index([receipt_id])
  @@index([variant_id])
  @@map("receipt_items")
}

// ============================================================
// BẢNG: export_receipts
// Phiếu xuất kho: Nhân viên tạo, Quản lý duyệt
// ============================================================
model ExportReceipt {
  id               Int           @id @default(autoincrement())
  export_code      String        @unique @db.VarChar(50)
  warehouse_id     Int
  warehouse        Warehouse     @relation("ExportWarehouse", fields: [warehouse_id], references: [id], onDelete: Cascade)
  export_type      String        @default("SALE") @db.VarChar(50)
  customer_name    String?       @db.VarChar(150)
  created_by_id    Int
  created_by       User          @relation("ExportCreatedBy", fields: [created_by_id], references: [id], onDelete: Cascade)
  approved_by_id   Int?
  approved_by      User?         @relation("ExportApprovedBy", fields: [approved_by_id], references: [id], onDelete: SetNull)
  status           ReceiptStatus @default(PENDING)
  total_quantity   Int           @default(0)
  total_amount     Decimal       @default(0.00) @db.Decimal(15, 2)
  notes            String?       @db.Text
  rejection_reason String?       @db.Text
  approved_at      DateTime?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  items            ExportReceiptItem[]

  @@index([warehouse_id])
  @@index([created_by_id])
  @@index([approved_by_id])
  @@map("export_receipts")
}

// ============================================================
// BẢNG: export_receipt_items
// Chi tiết mặt hàng trong phiếu xuất kho
// ============================================================
model ExportReceiptItem {
  id             Int            @id @default(autoincrement())
  export_id      Int
  export_receipt ExportReceipt  @relation(fields: [export_id], references: [id], onDelete: Cascade)
  variant_id     Int
  variant        ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  quantity       Int            @default(1)
  unit_price     Decimal        @default(0.00) @db.Decimal(15, 2)
  total_price    Decimal        @default(0.00) @db.Decimal(15, 2)
  shelf_location String?        @db.VarChar(50)
  notes          String?        @db.VarChar(255)

  @@index([export_id])
  @@index([variant_id])
  @@map("export_receipt_items")
}

// ============================================================
// BẢNG: stock_transfers
// Phiếu điều chuyển hàng giữa các kho: Nhân viên tạo, Quản lý duyệt & xác nhận
// ============================================================
model StockTransfer {
  id                 Int           @id @default(autoincrement())
  transfer_code      String        @unique @db.VarChar(50)
  from_warehouse_id  Int
  from_warehouse     Warehouse     @relation("TransferFromWarehouse", fields: [from_warehouse_id], references: [id], onDelete: Cascade)
  to_warehouse_id    Int
  to_warehouse       Warehouse     @relation("TransferToWarehouse", fields: [to_warehouse_id], references: [id], onDelete: Cascade)
  created_by_id      Int
  created_by         User          @relation("TransferCreatedBy", fields: [created_by_id], references: [id], onDelete: Cascade)
  approved_by_id     Int?
  approved_by        User?         @relation("TransferApprovedBy", fields: [approved_by_id], references: [id], onDelete: SetNull)
  status             ReceiptStatus @default(PENDING)
  total_quantity     Int           @default(0)
  notes              String?       @db.Text
  rejection_reason   String?       @db.Text
  approved_at        DateTime?
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  items              StockTransferItem[]

  @@index([from_warehouse_id])
  @@index([to_warehouse_id])
  @@index([created_by_id])
  @@index([approved_by_id])
  @@map("stock_transfers")
}

// ============================================================
// BẢNG: stock_transfer_items
// Chi tiết mặt hàng điều chuyển
// ============================================================
model StockTransferItem {
  id                  Int            @id @default(autoincrement())
  transfer_id         Int
  transfer            StockTransfer  @relation(fields: [transfer_id], references: [id], onDelete: Cascade)
  variant_id          Int
  variant             ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  quantity            Int            @default(1)
  from_shelf_location String?        @db.VarChar(50)
  to_shelf_location   String?        @db.VarChar(50)
  notes               String?        @db.VarChar(255)

  @@index([transfer_id])
  @@index([variant_id])
  @@map("stock_transfer_items")
}

// ============================================================
// BẢNG: stock_audits
// Quản lý đợt kiểm kê tồn kho
// ============================================================
model StockAudit {
  id                 Int               @id @default(autoincrement())
  audit_code         String            @unique @db.VarChar(50) // Ví dụ: KK-20261111-001
  warehouse_id       Int
  warehouse          Warehouse         @relation("AuditWarehouse", fields: [warehouse_id], references: [id])
  status             String            @default("PENDING") @db.VarChar(20) // PENDING (Chờ đếm), COUNTED (Đã đếm - Chờ duyệt), COMPLETED (Đã duyệt điều chỉnh), CANCELLED (Đã hủy)
  created_by_id      Int               // Quản lý tạo đợt kiểm kê (CHỈ DÀNH CHO QUẢN LÝ)
  created_by         User              @relation("AuditCreatedBy", fields: [created_by_id], references: [id])
  assigned_to_id     Int?              // Nhân viên thực hiện / kiểm đếm (CHỈ DÀNH CHO NHÂN VIÊN)
  assigned_to        User?             @relation("AuditAssignedTo", fields: [assigned_to_id], references: [id])
  approved_by_id     Int?              // Quản lý duyệt điều chỉnh chênh lệch (CHỈ DÀNH CHO QUẢN LÝ)
  approved_by        User?             @relation("AuditApprovedBy", fields: [approved_by_id], references: [id])
  notes              String?           @db.Text
  manager_feedback   String?           @db.Text
  total_system_qty   Int               @default(0)
  total_actual_qty   Int               @default(0)
  total_discrepancy  Int               @default(0)
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt
  counted_at         DateTime?
  completed_at       DateTime?

  items              StockAuditItem[]

  @@index([warehouse_id])
  @@index([created_by_id])
  @@index([assigned_to_id])
  @@index([approved_by_id])
  @@map("stock_audits")
}

// ============================================================
// BẢNG: stock_audit_items
// Chi tiết mặt hàng kiểm kê và chênh lệch
// ============================================================
model StockAuditItem {
  id                 Int            @id @default(autoincrement())
  audit_id           Int
  audit              StockAudit     @relation(fields: [audit_id], references: [id], onDelete: Cascade)
  variant_id         Int
  variant            ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  shelf_location     String?        @db.VarChar(50)
  system_quantity    Int            @default(0)
  actual_quantity    Int?           // NULL khi mới tạo, nhân viên sẽ nhập vào khi kiểm đếm
  discrepancy        Int            @default(0) // actual_quantity - system_quantity
  reason             String?        @db.VarChar(255)
  is_adjusted        Boolean        @default(false)

  @@index([audit_id])
  @@index([variant_id])
  @@map("stock_audit_items")
}

// ============================================================
// BẢNG: historical_sales
// Dữ liệu bán hàng lịch sử phục vụ AI dự báo nhu cầu (US-34, US-35, US-36)
// ============================================================
model HistoricalSale {
  id           Int            @id @default(autoincrement())
  sale_date    DateTime       @db.Date
  warehouse_id Int
  warehouse    Warehouse      @relation("WarehouseHistoricalSales", fields: [warehouse_id], references: [id], onDelete: Cascade)
  variant_id   Int
  variant      ProductVariant @relation("VariantHistoricalSales", fields: [variant_id], references: [id], onDelete: Cascade)
  quantity     Int            @default(1)
  unit_price   Decimal        @default(0.00) @db.Decimal(15, 2)
  total_amount Decimal        @default(0.00) @db.Decimal(15, 2)
  channel      String?        @default("STORE") @db.VarChar(50)
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt

  @@unique([sale_date, warehouse_id, variant_id], name: "sale_date_warehouse_variant_unique")
  @@index([sale_date])
  @@index([warehouse_id])
  @@index([variant_id])
  @@map("historical_sales")
}

// ============================================================
// BẢNG: replenishment_suggestions (Epic 4.2: US-37, US-38, US-39)
// Đề xuất nhập hàng thông minh bằng AI
// ============================================================
model ReplenishmentSuggestion {
  id                  Int             @id @default(autoincrement())
  suggestion_code     String          @unique @db.VarChar(50)
  warehouse_id        Int
  variant_id          Int
  product_id          Int
  supplier_id         Int
  period_key          String          @db.VarChar(50)
  daily_demand        Float           @default(0)
  lead_time           Int             @default(7)
  demand_in_lead_time Int             @default(0)
  current_stock       Int             @default(0)
  pending_export_qty  Int             @default(0)
  available_stock     Int             @default(0)
  incoming_stock      Int             @default(0)
  safety_stock        Int             @default(10)
  raw_suggested_qty   Int             @default(0)
  min_order_qty       Int             @default(10)
  ai_suggested_qty    Int             @default(0)
  adjusted_qty        Int?
  days_of_supply      Float           @default(0)
  latest_order_date   DateTime?
  urgency_level       String          @default("NORMAL") @db.VarChar(20) // URGENT | HIGH | NORMAL
  calculation_details String?         @db.Text // Snapshot JSON công thức & dữ liệu tính toán
  status              String          @default("PENDING") @db.VarChar(30) // PENDING | APPROVED | REJECTED | ORDERED
  rejection_reason    String?         @db.VarChar(255)
  purchase_order_id   Int?
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt

  warehouse           Warehouse       @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)
  variant             ProductVariant  @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  product             Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  supplier            Supplier        @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  purchase_order      PurchaseOrder?  @relation(fields: [purchase_order_id], references: [id], onDelete: SetNull)

  @@index([warehouse_id])
  @@index([variant_id])
  @@index([supplier_id])
  @@index([status])
  @@index([period_key])
  @@map("replenishment_suggestions")
}

// ============================================================
// BẢNG: purchase_orders (Epic 4.2: US-40)
// Đơn đặt hàng nhà cung cấp (PO)
// ============================================================
model PurchaseOrder {
  id                     Int                         @id @default(autoincrement())
  po_code                String                      @unique @db.VarChar(50)
  supplier_id            Int
  warehouse_id           Int
  order_date             DateTime                    @default(now())
  expected_delivery_date DateTime
  total_items            Int                         @default(0)
  total_quantity         Int                         @default(0)
  total_amount           Decimal                     @default(0.00) @db.Decimal(15, 2)
  status                 String                      @default("PENDING") @db.VarChar(30) // PENDING | SENT | CONFIRMED | COMPLETED | CANCELLED
  notes                  String?                     @db.Text
  created_by_id          Int?
  created_at             DateTime                    @default(now())
  updated_at             DateTime                    @updatedAt

  supplier               Supplier                    @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  warehouse              Warehouse                   @relation(fields: [warehouse_id], references: [id], onDelete: Restrict)
  created_by             User?                       @relation("UserPurchaseOrders", fields: [created_by_id], references: [id], onDelete: SetNull)
  items                  PurchaseOrderItem[]
  suggestions            ReplenishmentSuggestion[]

  @@index([supplier_id])
  @@index([warehouse_id])
  @@index([status])
  @@map("purchase_orders")
}

// ============================================================
// BẢNG: purchase_order_items (Epic 4.2: US-40)
// Chi tiết mặt hàng trong Đơn đặt hàng nhà cung cấp
// ============================================================
model PurchaseOrderItem {
  id                Int             @id @default(autoincrement())
  purchase_order_id Int
  variant_id        Int
  quantity          Int             @default(0)
  unit_price        Decimal         @default(0.00) @db.Decimal(15, 2)
  total_price       Decimal         @default(0.00) @db.Decimal(15, 2)
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  purchase_order    PurchaseOrder   @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade)
  variant           ProductVariant  @relation(fields: [variant_id], references: [id], onDelete: Restrict)

  @@index([purchase_order_id])
  @@index([variant_id])
  @@map("purchase_order_items")
}

// ============================================================
// BẢNG: system_alerts (Theme 5: US-41 -> US-46)
// Cảnh báo thông minh: LOW_STOCK, BROKEN_SIZE, STOCKOUT_FORECAST, OVERSTOCK_SLOW
// ============================================================
model SystemAlert {
  id              Int       @id @default(autoincrement())
  alert_code      String    @unique @db.VarChar(100)
  alert_type      String    @db.VarChar(50) // LOW_STOCK | BROKEN_SIZE | STOCKOUT_FORECAST | OVERSTOCK_SLOW
  warehouse_id    Int
  product_id      Int?
  variant_id      Int?
  title           String    @db.VarChar(255)
  message         String    @db.Text
  urgency         String    @default("HIGH") @db.VarChar(20) // URGENT | HIGH | MEDIUM | LOW
  target_role     String    @default("STAFF") @db.VarChar(30) // STAFF (Staff & Manager) | MANAGER (Manager only)
  current_stock   Int       @default(0)
  threshold_stock Int?      // min_stock hoặc ngưỡng cảnh báo
  days_of_supply  Float?
  stagnant_days   Int?      // số ngày không bán được hàng
  capital_tied_up Decimal?  @default(0.00) @db.Decimal(15, 2) // Giá trị vốn đọng = Tồn * Giá vốn
  extra_data      String?   @db.Text // JSON chứa chi tiết bổ sung (core sizes, các size còn lại, v.v.)
  status          String    @default("OPEN") @db.VarChar(20) // OPEN | RESOLVED | ACKNOWLEDGED
  resolved_at     DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  warehouse       Warehouse       @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)
  product         Product?        @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  recipients      NotificationRecipient[]

  @@index([warehouse_id])
  @@index([alert_type])
  @@index([status])
  @@index([target_role])
  @@index([variant_id])
  @@map("system_alerts")
}

// ============================================================
// BẢNG: notification_recipients (US-45, US-46)
// Trạng thái thông báo cá nhân hóa theo từng User (Đã đọc, Đã ẩn/xóa)
// ============================================================
model NotificationRecipient {
  id           Int         @id @default(autoincrement())
  alert_id     Int
  user_id      Int
  is_read      Boolean     @default(false)
  is_dismissed Boolean     @default(false) // Ẩn/Xóa cá nhân theo user_id (không ảnh hưởng user khác)
  read_at      DateTime?
  dismissed_at DateTime?
  created_at   DateTime    @default(now())

  alert        SystemAlert @relation(fields: [alert_id], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([alert_id, user_id], name: "alert_user_unique")
  @@index([user_id, is_read])
  @@index([user_id, is_dismissed])
  @@map("notification_recipients")
}
